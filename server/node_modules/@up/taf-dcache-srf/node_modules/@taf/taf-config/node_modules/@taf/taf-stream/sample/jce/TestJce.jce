module TTT
{
	struct UserInfo
	{
		0 require 	int 	uid;
		1 optional	double	price; 	
		2 optional	double 	price2;
		3 optional 	float 	f1;
		4 optional	float 	f2;
		5 optional	vector<double> vd1;
		6 optional	vector<float> 	vf1;
		7 optional 	map<float, double>	mfd;
	};
	
	struct UserData
	{
		0 require 	string 		flag;
		1 optional 	UserInfo	info;
		2 optional	double 		d1;
		3 optional	string 		str1;
		4 optional	float 		f1;
	};

	struct UserSimple
	{
		0 require	int			a;
		1 optional	int			b;
	};

	struct NotSimple
	{
		14 require	int			a;
		15 optional int			b;
	};
};