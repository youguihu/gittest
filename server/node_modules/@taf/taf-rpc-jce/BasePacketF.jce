
module taf
{
    struct BasePacket
    {
        1  optional short               iVersion;             //协议版本, 1:jce协议, 2:wup协议, 有效
        2  optional byte                cPacketType  = 0;     //包类型, 和BaseF.jce中对应
        3  optional int                 iMessageType = 0;     //消息类型,和BaseF.jce中对应
        4  optional int                 iRequestId;           //请求id和相应id,需要对应
        5  optional int                 iRet         = 0;     //如果作为请求包, 则无效, 如果作为响应包则作为服务器框架的返回值,和BaseF.jce对应
        6  optional string              sServantName = "";    //对象名
        7  optional string              sFuncName    = "";    //函数名
        8  optional vector<byte>        sBuffer;              //数据buffer,格式和iVersion有关
        9  optional int                 iTimeout     = 0;     //请求当前时间,服务器端可以根据这个时间做超时保护,作为请求包有效
        10 optional string              sResultDesc;          //如果作为请求包, 则无效, 如果作为响应包则作为服务器框架异常描述
        11 optional map<string, string> context;              //上下文,可以通过context附带更多的参数到服务器端
        12 optional map<string, string> status;               //状态,可以在多个taf服务器间自动传递,通常业务开发者不用处理, 主要用来做染色用
    };
};

